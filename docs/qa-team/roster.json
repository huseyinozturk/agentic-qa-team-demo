{
  "_note": "Single source for model, trigger, budget and write scope per role. scripts/check-agents.ts verifies the agent files against it; scripts/run-agent.sh reads the budget.",
  "roles": {
    "qa-lead":             { "model": "opus",   "trigger": "owner, interactive; Watcher reports", "budgetUsd": 3, "tools": ["Read", "Grep", "Glob", "Edit", "Write", "Agent", "Bash"], "writes": ["docs/qa-team/lead/", "e2e/test-plan.json"] },
    "watcher":             { "model": "sonnet", "trigger": "weekday morning, on request",         "budgetUsd": 1, "tools": ["Read", "Grep", "Glob", "Write"],                         "writes": ["docs/qa-team/watch/"] },
    "analyst":             { "model": "opus",   "trigger": "task file from the lead",             "budgetUsd": 2, "tools": ["Read", "Grep", "Glob", "Edit", "Write"],                  "writes": ["docs/cases/"] },
    "automation-engineer": { "model": "sonnet", "trigger": "task file from the lead",             "budgetUsd": 2, "tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"],          "writes": ["e2e/flows/", "e2e/subflows/", "docs/qa-team/testid-requests.md"] },
    "runner":              { "model": "sonnet", "trigger": "test plan: per build, nightly, pre-release", "budgetUsd": 1, "tools": ["Read", "Grep", "Glob", "Write", "Bash"],           "writes": ["docs/qa-team/runs/"] }
  }
}

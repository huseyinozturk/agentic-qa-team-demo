    "automation-engineer": { "model": "sonnet", "trigger": "task file from the lead",     "budgetUsd": 2, "tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"],          "writes": ["e2e/flows/", "e2e/subflows/"] },
    "runner":              { "model": "sonnet", "trigger": "nightly, on request",         "budgetUsd": 1, "tools": ["Read", "Grep", "Glob", "Write", "Bash"],                  "writes": ["docs/qa-team/runs/"] }
